{
  "name": "@asterisk-labs/iris",
  "version": "1.0.1",
  "description": "Segmentation of satellite images in the browser, without a server",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "iris": "bin/iris.mjs"
  },
  "files": [
    "bin/iris.mjs",
    "bin/server.mjs",
    "dist",
    "template",
    "scripts/credentials.mjs"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "credentials": "node scripts/credentials.mjs",
    "demo": "npm run build && node bin/iris.mjs demo",
    "prepack": "npm run build"
  },
  "keywords": [
    "segmentation",
    "satellite",
    "earth-observation",
    "cog",
    "labelling",
    "maplibre"
  ],
  "homepage": "https://asterisk.coop/iris/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asterisk-labs/iris.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@developmentseed/epsg": "0.8.1",
    "@huggingface/hub": "2.17.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "0.8.3",
    "geotiff": "3.0.5",
    "jsdom": "^30.1.2",
    "maplibre-gl": "^6.11.2",
    "proj4": "2.20.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zustand": "^5.0.9"
  }
}
